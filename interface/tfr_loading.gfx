spriteTypes = {

	# Full-screen black plate. A cornered tile sprite renders at the size
	# declared here regardless of how small the texture is, so 3840x2160
	# covers everything up to 4K.
	corneredTileSpriteType = {
		name = "GFX_TFR_load_black"
		texturefile = "gfx/interface/tfr_load_black.dds"
		borderSize = { x = 0 y = 0 }
		size = { x = 3840 y = 2160 }
		tilingCenter = no
	}

	# The animated TFR wordmark. The shader does the reveal, the bulb and the shadows.
	spriteType = {
		name = "GFX_TFR_load_logo"
		texturefile = "gfx/interface/tfr_load_logo.dds"
		effectFile = "gfx/FX/tfr_loading.shader"
		legacy_lazy_load = no
		noOfFrames = 1
		alwaystransparent = yes
	}
}
