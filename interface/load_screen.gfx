	# ---- TFR animated loading screen -------------------------------------
	# These MUST live in load_screen.gfx: the loading screen is built before
	# the rest of interface/*.gfx is parsed, and a sprite it cannot resolve is
	# a hard crash ("No [GFX_default_fallback_texture] defined").

	spriteType = {
		name = "GFX_TFR_load_black"
		texturefile = "gfx/interface/tfr_load_black.dds"
		noOfFrames = 1
		alwaystransparent = yes
	}

	spriteType = {
		name = "GFX_TFR_load_logo"
		texturefile = "gfx/interface/tfr_load_logo.dds"
		effectFile = "gfx/FX/tfr_loading.shader"
		legacy_lazy_load = no
		noOfFrames = 1
		alwaystransparent = yes
	}
}
