guiTypes = {

	# TFR loading screen.
	# NOTE: this is a legacy windowType. It only accepts iconType,
	# instantTextBoxType and nested windowType children - nothing else parses.
	windowType = {
		name = "load_screen"
		backGround ="GFX_TFR_load_black"
		position = { x = 0 y = 0 }
		size = { x = 1024 y = 768 }
		moveable = 0
		dontRender = ""
		horizontalBorder = "0"
		verticalBorder = ""
		fullScreen = yes
		Orientation = "UPPER_LEFT"

		# Black plate, drawn first so everything below sits on top of it.
		iconType = {
			name = "TFR_loading_black"
			spriteType = "GFX_TFR_load_black"
			position = { x = -1920 y = -1080 }
			Orientation = "CENTER"
			alwaystransparent = yes
		}

		# The animated wordmark. Reveal, travelling light and cast shadows all
		# live in gfx/FX/tfr_loading.shader.
		iconType = {
			name = "TFR_loading_logo"
			spriteType = "GFX_TFR_load_logo"
			position = { x = -700 y = -390 }
			Orientation = "CENTER"
			alwaystransparent = yes
		}

		iconType = {
			name ="bg_clausewitz_logo"
			spriteType = "GFX_clausewitz_logo"
			position = { x= 23 y = -152 }
			Orientation = "LOWER_LEFT"
		}

		iconType = {
			name ="bg_pdx_int_logo"
			spriteType = "GFX_frontend_dev_logo_s"
			position = { x= -130 y = -158 }
			Orientation = "LOWER_RIGHT"
		}

		# Progress bar, moved to the bottom of the screen. The decorated vanilla
		# panel behind it is gone, the bar itself stays.
		windowType = {
			name = "status"
			backGround =""
			position = { x = 0 y = 0 }
			size = { x = 1024 y = 768 }
			moveable = 0
			dontRender = ""
			horizontalBorder = "0"
			verticalBorder = ""
			fullScreen = no
			Orientation = "CENTER_DOWN"

			instantTextBoxType = {
				name = "text"
				position = { x = -400 y = -148 }
				textureFile = ""
				font = "loadscreen_header"
				borderSize = {x = 0 y = 0}
				text = ""
				maxWidth = 800
				maxHeight = 40
				fixedsize = yes
				format = centre
			}

			iconType =
			{
				name = "progressbar"
				spriteType = "GFX_loadingstatus_progress"
				position = { x=-467 y=-105 }
			}
		}

		# Tips are pushed off-screen; the engine still has a textbox to write into.
		windowType = {
			name = "tip"
			backGround =""
			position = { x = 0 y = 6000 }
			size = { x = 1024 y = 200 }
			moveable = 0
			dontRender = ""
			horizontalBorder = "0"
			verticalBorder = ""
			fullScreen = no
			Orientation = "CENTER_DOWN"

			instantTextBoxType = {
				name = "text"
				position = { x = -450 y = -157 }
				textureFile = ""
				font = "loadscreen_tip"
				borderSize = {x = 0 y = 0}
				text = ""
				maxWidth = 900
				maxHeight = 200
				fixedsize = yes
				format = centre
				vertical_alignment = center
			}
		}
	}
}
