spriteTypes = {

	# Main menu background: the same solid black plate the loading screen uses.
	spriteType = {
		name = "GFX_TFR_menu_bg"
		texturefile = "gfx/interface/tfr_load_black.dds"
		noOfFrames = 1
		alwaystransparent = yes
	}

	# The wordmark, revealed by a light on first appearance and lit by a slow
	# pass every few seconds afterwards.
	spriteType = {
		name = "GFX_TFR_menu_logo"
		texturefile = "gfx/interface/tfr_load_logo.dds"
		effectFile = "gfx/FX/tfr_menu.shader"
		legacy_lazy_load = no
		noOfFrames = 1
		alwaystransparent = yes
	}

	# Intro curtain.
	spriteType = {
		name = "GFX_TFR_intro_veil"
		texturefile = "gfx/interface/tfr_load_black.dds"
		effectFile = "gfx/FX/tfr_intro_veil.shader"
		legacy_lazy_load = no
		noOfFrames = 1
		alwaystransparent = yes
	}
}
